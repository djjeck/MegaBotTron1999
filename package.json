{
  "name": "megabottron1999",
  "version": "0.1.17",
  "private": true,
  "description": "A plugin-based bot shell for chat networks, with a node-graph web UI",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc && tsc -p packages/web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build --workspace @megabottron1999/web",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "validate": "npm run test:coverage && npm run typecheck && npm run lint:fix && npm run lint && npm run format:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
